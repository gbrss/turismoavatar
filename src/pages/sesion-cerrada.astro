---
import '@/styles/global.css';
---

<!doctype html>
<html lang="es-CL">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Sesión cerrada · Turismo Avatar</title>
    <link rel="icon" href="/favicon-64.png" type="image/png" />
  </head>
  <body class="grid min-h-dvh place-items-center bg-niebla p-6 antialiased">
    <main class="max-w-md rounded-3xl bg-white p-8 text-center ring-1 ring-roca">
      <img src="/icon-192.png" alt="" width="64" height="64" class="mx-auto h-16 w-16" />
      <h1 class="mt-4 text-h2">Cerraste la sesión</h1>
      <p class="mt-2 text-gris">Para volver a entrar al panel te pediremos la contraseña de nuevo.</p>
      <a href="/admin" class="btn btn-primary mt-6">Entrar de nuevo</a>
      <p class="mt-4"><a href="/" class="font-bold text-naranja-700 underline underline-offset-4">Ir al sitio</a></p>
    </main>
  </body>
</html>
