---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import BookingForm from '@/components/BookingForm.astro';
import { site, whatsappLink } from '@/data/site';
---

<Base title="Reservas" description="Reserva experiencias, programas y alojamientos de Turismo Avatar en Concepción y el Biobío. Confirmación rápida por WhatsApp.">
  <PageHero title="Reserva tu experiencia" lead="Completa el formulario y te confirmamos disponibilidad y forma de pago, normalmente el mismo día. No se cobra nada al enviar la solicitud." crumbs={[{ href: '/reservas', label: 'Reservas' }]} />
  <section class="wrap grid gap-12 pb-24 lg:grid-cols-[1.5fr_1fr]">
    <div class="rounded-2xl bg-white p-6 sm:p-10"><BookingForm /></div>
    <aside class="grid content-start gap-6">
      <section class="rounded-2xl bg-marino p-6 text-white">
        <h2 class="font-display text-2xl font-extrabold">Cómo funciona</h2>
        <ol class="mt-4 grid gap-3">
          <li><strong>1. Envías tu solicitud</strong> con fecha y número de personas.</li>
          <li><strong>2. Te confirmamos</strong> disponibilidad y te enviamos los datos de pago.</li>
          <li><strong>3. Recibes los detalles</strong> de tu experiencia: punto de encuentro, horario y qué llevar.</li>
        </ol>
      </section>
      <a href={whatsappLink()} target="_blank" rel="noopener" class="btn btn-wa">¿Prefieres WhatsApp? {site.phoneDisplay}</a>
      <p class="text-sm text-gris">Al enviar aceptas nuestras <a href="/politicas" class="underline">políticas de reserva y privacidad</a>.</p>
    </aside>
  </section>
</Base>
