---
import Base from '@/layouts/Base.astro';
---

<Base title="Página no encontrada" noindex>
  <section class="wrap py-28">
    <h1 class="text-h1">Este sendero no lleva a ninguna parte</h1>
    <p class="mt-4 max-w-xl text-lg text-gris">La página que buscas no existe o cambió de lugar con el nuevo sitio. Prueba con alguna de estas rutas:</p>
    <div class="mt-8 flex flex-wrap gap-3">
      <a href="/experiencias" class="btn btn-primary">Ver experiencias</a>
      <a href="/alojamientos" class="btn btn-ghost text-marino">Alojamientos</a>
      <a href="/" class="btn btn-ghost text-marino">Ir al inicio</a>
    </div>
  </section>
</Base>
