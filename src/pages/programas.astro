---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Media from '@/components/Media.astro';
import CtaBand from '@/components/CtaBand.astro';
import GeneradorProgramas from '@/components/GeneradorProgramas.astro';
import { getCollection } from 'astro:content';
import { site, whatsappLink, clp } from '@/data/site';

const progs = (await getCollection('programas')).sort((a, b) => a.data.order - b.data.order);
const generales = progs.filter((p) => p.data.group === 'general');
const terceraEdad = progs.filter((p) => p.data.group === 'tercera-edad');
const exps = (await getCollection('experiencias')).sort((a, b) => a.data.order - b.data.order);
const expTitle = (id: string) => exps.find((e) => e.id === id)?.data.title ?? id;

---

<Base title="Programas, itinerarios y escapadas en el Biobío" description="Genera tu programa turístico en 3 pasos (perfil, origen y duración) o elige un itinerario: Experiencia Tomé, Gran Concepción en un día, escapada costera y Vacaciones Tercera Edad 2026 desde $103.256.">
  <PageHero title="Programas e itinerarios" lead="Combinaciones de experiencias y alojamiento listas para reservar, o genera un programa a tu medida en tres pasos." crumbs={[{ href: '/programas', label: 'Programas' }]} />

  <GeneradorProgramas />

  <!-- Programas listos -->
  <div class="wrap grid gap-24 pb-24">
    {generales.map((p, i) => (
      <article id={p.id} class="grid scroll-mt-28 gap-10 lg:grid-cols-2 lg:items-start">
        <div class:list={['aspect-[4/3] overflow-hidden rounded-3xl bg-marino lg:sticky lg:top-28', i % 2 && 'lg:order-2']}>
          <Media src={p.data.image} alt={p.data.title} sizes="(min-width: 1024px) 50vw, 100vw" />
        </div>
        <div>
          <p class="font-bold text-cielo-700">{p.data.days} {p.data.days === 1 ? 'día' : 'días'}{p.data.nights ? ` / ${p.data.nights} noches` : ''} · {p.data.idealFor}</p>
          <h2 class="mt-2 text-h2">{p.data.title}</h2>
          <p class="mt-3 text-lg text-gris">{p.data.summary}</p>
          {p.data.tags.length > 0 && <ul class="mt-4 flex flex-wrap gap-2">{p.data.tags.map((t) => <li class="rounded-full bg-naranja/15 px-3 py-1 text-sm font-bold text-naranja-700">{t}</li>)}</ul>}
          <ol class="mt-8 grid gap-6">
            {p.data.plan.map((day) => (
              <li class="border-l-[3px] border-naranja pl-5">
                <h3 class="font-display text-xl font-extrabold">{p.data.days > 1 ? `Día ${day.day}: ` : ''}{day.title}</h3>
                <ul class="mt-2 grid gap-1.5 text-gris">{day.items.map((it) => <li>{it}</li>)}</ul>
              </li>
            ))}
          </ol>
          {p.data.includes.length > 0 && <p class="mt-6"><strong>Incluye:</strong> {p.data.includes.join(', ')}.</p>}
          {p.data.experiencias.length > 0 && (
            <p class="mt-2 text-gris">Experiencias del programa: {p.data.experiencias.map((id, j) => <>{j > 0 && ', '}<a class="font-semibold text-marino underline" href={`/experiencias/${id}`}>{expTitle(id)}</a></>)}</p>
          )}
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={`/reservas?item=programa:${p.id}`} class="btn btn-primary">Reservar este programa</a>
            <a href={whatsappLink(`${site.whatsappGreeting} el programa "${p.data.title}".`)} target="_blank" rel="noopener" class="btn btn-ghost text-marino">Consultar por WhatsApp</a>
          </div>
        </div>
      </article>
    ))}
  </div>

  <!-- Tercera edad -->
  <section id="tercera-edad" class="scroll-mt-20 bg-marino py-20 text-white sm:py-28">
    <div class="wrap">
      <p class="font-bold text-naranja">Vacaciones Tercera Edad · Escapadas 2026</p>
      <h2 class="mt-2 max-w-3xl text-h2">Viaja, relájate y disfruta Chile</h2>
      <p class="mt-4 max-w-2xl text-lg text-white/80">Cuatro destinos increíbles con todo coordinado para que solo te preocupes de disfrutar. Valores por persona.</p>
      <ol class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {terceraEdad.map((p) => (
          <li class="flex flex-col rounded-3xl bg-white p-6 text-tinta">
            <span class="font-bold text-cielo-700">{p.data.days} días / {p.data.nights} noches</span>
            <h3 class="mt-2 font-display text-2xl font-extrabold leading-tight">{p.data.title}</h3>
            <p class="mt-2 flex-1 text-gris">{p.data.summary}</p>
            <p class="mt-5 text-sm text-gris">Desde</p>
            <p class="font-display text-3xl font-extrabold">{clp(p.data.priceFrom!)}</p>
            <p class="text-sm text-gris">por persona</p>
            <a href={`/tercera-edad?destino=${p.id}#reservar`} class="btn btn-primary mt-5">Reservar</a>
          </li>
        ))}
      </ol>
      <p class="mt-8 text-white/70">¿Viajan en grupo, club o junta de vecinos? <a class="font-bold text-naranja underline" href={whatsappLink(`${site.whatsappGreeting} las Vacaciones Tercera Edad 2026 para un grupo.`)} target="_blank" rel="noopener">Pide una cotización grupal</a>.</p>
    </div>
  </section>

  <CtaBand title="¿Quieres un programa a tu medida?" text="Dinos cuántos días tienes y qué te gusta. Te armamos un itinerario con experiencias, traslados y alojamiento." />
</Base>
