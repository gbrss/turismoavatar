---
import Base from '@/layouts/Base.astro';
import PageHero from '@/components/PageHero.astro';
import Media from '@/components/Media.astro';
import CtaBand from '@/components/CtaBand.astro';
import { getCollection } from 'astro:content';
import { site, whatsappLink } from '@/data/site';

const progs = (await getCollection('programas')).sort((a, b) => a.data.order - b.data.order);
const exps = await getCollection('experiencias');
const expTitle = (id: string) => exps.find((e) => e.id === id)?.data.title ?? id;
---

<Base title="Programas e itinerarios de 1 a 3 días en el Biobío" description="Itinerarios armados para conocer Concepción, la costa de Tomé, Penco y Hualpén en 1, 2 o 3 días, con actividades y alojamiento coordinados.">
  <PageHero title="Programas e itinerarios" lead="Combinaciones probadas de experiencias y alojamiento. Las ajustamos a tus fechas, grupo y presupuesto." crumbs={[{ href: '/programas', label: 'Programas' }]} />
  <div class="wrap grid gap-24 pb-24">
    {progs.map((p, i) => (
      <article id={p.id} class="grid scroll-mt-28 gap-10 lg:grid-cols-2 lg:items-start">
        <div class:list={['aspect-[4/3] overflow-hidden rounded-2xl bg-rio lg:sticky lg:top-28', i % 2 && 'lg:order-2']}>
          <Media src={p.data.image} alt={p.data.title} sizes="(min-width: 1024px) 50vw, 100vw" />
        </div>
        <div>
          <p class="font-semibold text-laguna">{p.data.days} {p.data.days === 1 ? 'día' : 'días'} · {p.data.idealFor}</p>
          <h2 class="mt-2 text-h2">{p.data.title}</h2>
          <p class="mt-3 text-lg text-gris">{p.data.summary}</p>
          <ol class="mt-8 grid gap-6">
            {p.data.plan.map((day) => (
              <li class="border-l-2 border-copihue pl-5">
                <h3 class="font-display text-2xl font-extrabold">Día {day.day}: {day.title}</h3>
                <ul class="mt-2 grid gap-1.5 text-gris">{day.items.map((it) => <li>{it}</li>)}</ul>
              </li>
            ))}
          </ol>
          {p.data.includes.length > 0 && <p class="mt-6"><strong>Incluye:</strong> {p.data.includes.join(', ')}.</p>}
          {p.data.experiencias.length > 0 && (
            <p class="mt-2 text-gris">Experiencias del programa: {p.data.experiencias.map((id, j) => <>{j > 0 && ', '}<a class="text-rio underline" href={`/experiencias/${id}`}>{expTitle(id)}</a></>)}</p>
          )}
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={`/reservas?item=programa:${p.id}`} class="btn btn-primary">Reservar este programa</a>
            <a href={whatsappLink(`${site.whatsappGreeting} el programa "${p.data.title}".`)} target="_blank" rel="noopener" class="btn btn-ghost text-rio">Ajustarlo por WhatsApp</a>
          </div>
        </div>
      </article>
    ))}
  </div>
  <CtaBand title="¿Quieres un programa a tu medida?" text="Dinos cuántos días tienes y qué te gusta. Te armamos un itinerario con experiencias, traslados y alojamiento." />
</Base>
