---
import Base from '@/layouts/Base.astro';
import Media from '@/components/Media.astro';
import ExperienceCard from '@/components/ExperienceCard.astro';
import LodgingCard from '@/components/LodgingCard.astro';
import DestinosMap from '@/components/DestinosMap.astro';
import Gallery from '@/components/Gallery.astro';
import VideoGrid from '@/components/VideoGrid.astro';
import CtaBand from '@/components/CtaBand.astro';
import HeroVideo from '@/components/HeroVideo.astro';
import { getCollection } from 'astro:content';
import { categorias } from '@/content.config';
import { site, whatsappLink, clp } from '@/data/site';
import { galeria } from '@/data/galeria';
import { faq } from '@/data/faq';

const exps = (await getCollection('experiencias')).sort((a, b) => a.data.order - b.data.order);
const featured = exps.filter((e) => e.data.featured).slice(0, 4);
const alojs = (await getCollection('alojamientos')).sort((a, b) => a.data.order - b.data.order);
const progs = (await getCollection('programas')).sort((a, b) => a.data.order - b.data.order);
const tome = progs.find((p) => p.id === 'experiencia-tome');
const terceraEdad = progs.filter((p) => p.data.group === 'tercera-edad');
const minTercera = Math.min(...terceraEdad.map((p) => p.data.priceFrom ?? Infinity));
const sup = exps.find((e) => e.id === 'sup-dichato');

const pilares = [
  ['Guías expertos locales', 'Nacimos y vivimos en el Biobío. Te mostramos la región como la conocemos nosotros.'],
  ['Cuidamos el medio ambiente', 'Turismo sostenible que apoya a la comunidad local y respeta su entorno.'],
  ['Experiencias personalizadas', 'Ajustamos cada salida a tu grupo, tu ritmo y lo que quieres vivir.'],
  ['Actividades bien planificadas', 'Equipos, seguridad y logística resueltos para que solo disfrutes.'],
];
const linkCls = 'text-white/80 hover:text-white hover:underline hover:decoration-naranja hover:decoration-2 hover:underline-offset-8';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.slice(0, 4).map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
---

<Base transparentHeader jsonLd={faqLd} image="2024/11/GOPR3756_1737677330009-scaled.jpg">
  <!-- Portada -->
  <section class="relative isolate flex min-h-[94svh] flex-col justify-end overflow-hidden bg-marino text-white">
    <div class="absolute inset-0 -z-10">
      <Media
        src="2024/11/GOPR3756_1737677330009-scaled.jpg"
        alt="Grupo remando en SUP entre botes de pescadores en la bahía de Dichato"
        widths={[640, 1024, 1600, 2400]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
        class="object-[center_62%]"
      />
      <HeroVideo />
      <div class="absolute inset-0 bg-gradient-to-t from-marino-900 via-marino-900/40 to-marino-900/10"></div>
      <div class="absolute inset-y-0 left-0 w-2/3 bg-gradient-to-r from-marino-900/60 to-transparent"></div>
    </div>

    <div class="wrap grid gap-10 pb-10 pt-36 lg:grid-cols-[1fr_auto] lg:items-end lg:pb-14">
      <div>
        <p class="font-display text-lg font-bold text-naranja">Tour operador en Concepción desde {site.foundingYear}</p>
        <h1 class="mt-4 max-w-4xl text-display">Diseñamos experiencias memorables en el Biobío</h1>
        <p class="mt-6 max-w-xl text-lg text-white/85 sm:text-xl">
          Trekking, SUP en el mar, city tours por las siete lagunas y cabañas con tinaja frente a la costa. Con guías locales que conocen cada rincón.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/experiencias" class="btn btn-primary">Ver experiencias</a>
          <a href={whatsappLink()} target="_blank" rel="noopener" class="btn btn-ghost" data-track="whatsapp_hero">Cotizar por WhatsApp</a>
          <button type="button" class="btn text-white hover:bg-white/10" data-video-open={site.featuredVideo} data-video-title="Turismo Avatar en Chile">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 100 20 10 10 0 000-20zm-2 14.5v-9l7 4.5-7 4.5z" /></svg>
            Ver video
          </button>
        </div>
      </div>

      {
        sup && (
          <a href={`/experiencias/${sup.id}`} class="group hidden w-80 rounded-2xl bg-white/95 p-5 text-tinta shadow-2xl backdrop-blur lg:block">
            <p class="text-sm font-bold text-cielo-700">La más reservada</p>
            <p class="mt-1 font-display text-xl font-extrabold leading-tight group-hover:text-naranja-700">{sup.data.title}</p>
            <p class="mt-2 text-sm text-gris">{sup.data.duration} · sin experiencia previa · desde {sup.data.minAge} años</p>
            <p class="mt-3 flex items-baseline justify-between">
              <span class="font-display text-2xl font-extrabold">{clp(sup.data.priceFrom!)}</span>
              <span class="text-sm font-bold text-naranja-700 underline decoration-2 underline-offset-4">Reservar</span>
            </p>
          </a>
        )
      }
    </div>

    <nav aria-label="¿Qué quieres vivir?" class="border-t border-white/15 bg-marino-900/40 backdrop-blur-sm">
      <ul class="wrap flex gap-x-7 gap-y-2 overflow-x-auto whitespace-nowrap py-4 font-display text-[0.95rem] font-bold">
        {Object.entries(categorias).map(([k, label]) => <li><a href={`/experiencias?categoria=${k}`} class={linkCls}>{label}</a></li>)}
        <li><a href="/alojamientos" class={linkCls}>Alojamientos</a></li>
        <li><a href="/programas#tercera-edad" class={linkCls}>Tercera edad</a></li>
        <li><a href="/rally-wrc" class={linkCls}>Rally WRC</a></li>
        <li><a href="/tienda" class={linkCls}>Tienda</a></li>
      </ul>
    </nav>
  </section>

  <!-- Experiencias con precio -->
  <section class="wrap py-20 sm:py-28" aria-labelledby="destacadas">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 id="destacadas" class="max-w-2xl text-h2">Escoge tu aventura ideal</h2>
        <p class="mt-3 max-w-xl text-lg text-gris">Salidas con guía local, equipos incluidos y precios claros desde el primer clic.</p>
      </div>
      <a href="/experiencias" class="font-bold text-naranja-700 underline decoration-2 underline-offset-4">Ver las {exps.length} experiencias</a>
    </div>
    <div class="mt-12 grid gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-4">
      {featured.map((e) => <ExperienceCard exp={e} />)}
    </div>
  </section>

  <!-- Promociones de temporada -->
  <section class="bg-white py-20 sm:py-28" aria-labelledby="promos">
    <div class="wrap">
      <h2 id="promos" class="text-h2">Promociones de temporada</h2>
      <div class="mt-10 grid gap-6 lg:grid-cols-[1.15fr_1fr]">
        {
          tome && (
            <a href="/programas#experiencia-tome" class="group relative isolate flex min-h-[26rem] flex-col justify-end overflow-hidden rounded-3xl p-7 text-white sm:p-9">
              <div class="absolute inset-0 -z-10">
                <Media src={tome.data.image} alt="" sizes="(min-width: 1024px) 55vw, 100vw" class="object-[center_35%] transition duration-700 group-hover:scale-[1.03]" />
                <div class="absolute inset-0 bg-gradient-to-t from-marino-900/95 via-marino-900/40 to-transparent" />
              </div>
              <ul class="flex flex-wrap gap-2">
                {['Trekking a Playa Montecristo', 'SUP en Dichato', 'Atardecer en Coliumo'].map((t) => (
                  <li class="rounded-full bg-white/15 px-3 py-1 text-sm font-semibold backdrop-blur">{t}</li>
                ))}
              </ul>
              <h3 class="mt-4 font-display text-4xl font-extrabold sm:text-5xl">Experiencia Tomé</h3>
              <p class="mt-2 max-w-md text-lg text-white/85">Tres experiencias, un día inolvidable. Naturaleza, aventura y diversidad. ¡Argentinos bienvenidos!</p>
              <span class="btn btn-primary mt-6 self-start">Reservar mi cupo</span>
            </a>
          )
        }
        <div class="grid gap-6">
          <a href="/programas#tercera-edad" class="group rounded-3xl bg-marino p-7 text-white sm:p-9">
            <p class="font-bold text-naranja">Vacaciones Tercera Edad · Escapadas 2026</p>
            <h3 class="mt-2 font-display text-3xl font-extrabold">Viaja, relájate y disfruta Chile</h3>
            <ul class="mt-6 grid grid-cols-2 gap-x-6 gap-y-3">
              {terceraEdad.map((p) => (
                <li class="border-l-2 border-cielo pl-3">
                  <span class="block font-display font-bold leading-tight">{p.data.title}</span>
                  <span class="text-sm text-white/70">{p.data.days} días · desde {clp(p.data.priceFrom!)}</span>
                </li>
              ))}
            </ul>
            <span class="mt-6 inline-block font-bold underline decoration-naranja decoration-2 underline-offset-4 group-hover:text-naranja">Desde {clp(minTercera)} por persona</span>
          </a>
          <a href="/rally-wrc" class="group relative isolate flex items-end overflow-hidden rounded-3xl p-7 text-white sm:p-9">
            <div class="absolute inset-0 -z-10">
              <Media src="youtube/aUodZdx7wPw.jpg" alt="" sizes="(min-width: 1024px) 45vw, 100vw" />
              <div class="absolute inset-0 bg-gradient-to-r from-marino-900/95 via-marino-900/85 to-marino-900/60" />
            </div>
            <div>
              <p class="font-bold text-naranja">WRC Rally Chile Biobío</p>
              <h3 class="mt-1 font-display text-2xl font-extrabold">Vive el Mundial de Rally sin preocuparte de nada</h3>
              <span class="mt-3 inline-block font-bold underline decoration-naranja decoration-2 underline-offset-4">Únete a la lista de espera</span>
            </div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Por qué Turismo Avatar -->
  <section class="wrap grid gap-14 py-20 sm:py-28 lg:grid-cols-2 lg:items-center" aria-labelledby="porque">
    <div class="relative order-2 grid grid-cols-[1.2fr_1fr] gap-4 lg:order-1">
      <div class="row-span-2 aspect-[3/4] overflow-hidden rounded-3xl bg-marino">
        <Media src="2025/08/IMG_20231204_121219.jpg" alt="Vuelo en parapente con Turismo Avatar sobre la costa del Biobío" sizes="(min-width: 1024px) 28vw, 55vw" />
      </div>
      <div class="aspect-square overflow-hidden rounded-3xl bg-marino">
        <Media src="2025/08/GOPR5827-scaled-e1747705915168-1024x1024-1.webp" alt="Guía de Turismo Avatar con tabla de SUP junto a la camioneta de la empresa" sizes="(min-width: 1024px) 20vw, 40vw" />
      </div>
      <div class="flex flex-col justify-end rounded-3xl bg-naranja p-5 text-marino">
        <span class="font-display text-5xl font-extrabold leading-none">{new Date().getFullYear() - site.foundingYear}+</span>
        <span class="mt-1 font-bold leading-tight">años creando experiencias en el Biobío</span>
      </div>
    </div>
    <div class="order-1 lg:order-2">
      <p class="font-display font-bold text-cielo-700">Turismo Avatar</p>
      <h2 id="porque" class="mt-2 text-h2">Descubre por qué somos tu mejor opción</h2>
      <p class="mt-5 max-w-xl text-lg text-gris">
        Ofrecemos experiencias turísticas únicas en Concepción con un servicio personalizado, seguro y de alta calidad. Nos apasiona compartir la riqueza cultural, histórica y natural de nuestra región con un turismo que también apoya a la comunidad local y su entorno.
      </p>
      <dl class="mt-10 grid gap-x-8 gap-y-7 sm:grid-cols-2">
        {pilares.map(([t, d]) => (
          <div>
            <dt class="flex items-center gap-3 font-display text-lg font-extrabold">
              <svg width="28" height="28" viewBox="0 0 100 100" class="shrink-0 text-naranja" aria-hidden="true"><circle cx="50" cy="50" r="44" fill="none" stroke="currentColor" stroke-width="7" /><path d="M50 18 L59 42 L84 42 L64 57 L71 82 L50 67 L29 82 L36 57 L16 42 L41 42 Z" fill="currentColor" /></svg>
              {t}
            </dt>
            <dd class="mt-1.5 pl-10 text-gris">{d}</dd>
          </div>
        ))}
      </dl>
      <p class="mt-10 text-sm text-gris">Somos parte de: {site.memberships.join(' · ')}</p>
    </div>
  </section>

  <!-- Destinos -->
  <section class="bg-white py-20 sm:py-28" aria-labelledby="destinos">
    <div class="wrap">
      <h2 id="destinos" class="text-h2">Escoge tu próximo destino</h2>
      <p class="mt-3 max-w-2xl text-lg text-gris">Lugares cuidadosamente seleccionados, desde los cerros de Concepción hasta las caletas de Tomé y el golfo de Arauco. Toca un punto para ver qué hacer ahí.</p>
      <div class="mt-12"><DestinosMap /></div>
    </div>
  </section>

  <!-- Alojamientos -->
  <section class="wrap grid gap-12 py-20 sm:py-28 lg:grid-cols-[1fr_1.6fr]" aria-labelledby="alojamientos">
    <div class="lg:sticky lg:top-28 lg:self-start">
      <h2 id="alojamientos" class="text-h2">¿Necesitas alojamiento en el Biobío?</h2>
      <p class="mt-4 text-lg text-gris">Descansa después de un día lleno de exploración. Cabañas con tinaja y piscina en Coliumo, hotel con desayuno en Dichato y opciones en Penco y Santa Bárbara.</p>
      <a href="/alojamientos" class="btn btn-primary mt-8">Ver alojamientos</a>
    </div>
    <div class="grid gap-8 sm:grid-cols-2 sm:gap-x-8">
      {alojs.map((a) => <LodgingCard item={a} />)}
    </div>
  </section>

  <!-- Videos y galería -->
  <section class="bg-marino py-20 text-white sm:py-28" aria-labelledby="galeria">
    <div class="wrap">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <h2 id="galeria" class="max-w-2xl text-h2">Nuestra galería de aventuras</h2>
          <p class="mt-3 max-w-xl text-lg text-white/75">Deja que cada foto te inspire a conquistar lo desconocido.</p>
        </div>
        <a href={site.social.instagram} target="_blank" rel="noopener" class="font-bold text-naranja underline decoration-2 underline-offset-4">Síguenos en Instagram @turismoavatar</a>
      </div>
      <div class="mt-10"><VideoGrid videos={site.videos.slice(0, 3)} dark /></div>
      <div class="mt-10"><Gallery items={galeria.slice(0, 12)} layout="strip" /></div>
      <a href="/galeria" class="btn btn-ghost mt-8">Ver galería completa</a>
    </div>
  </section>

  <!-- Oportunidades de negocio -->
  <section class="wrap grid gap-6 py-20 sm:py-28 md:grid-cols-2">
    <a href="/publica-tu-experiencia" class="group rounded-3xl bg-naranja p-8 text-marino sm:p-10">
      <h2 class="font-display text-[1.75rem] font-extrabold leading-tight sm:text-[2rem]">¿Quieres publicar tu experiencia turística?</h2>
      <p class="mt-3 max-w-md text-marino">Creemos que la cooperación en el turismo es clave. Si tienes cabañas, tours o un emprendimiento en el Biobío, súmate a nuestra vitrina.</p>
      <span class="mt-8 inline-block font-bold underline decoration-2 underline-offset-4">Quiero ser parte</span>
    </a>
    <a href="/empresas" class="group rounded-3xl border-2 border-marino p-8 sm:p-10">
      <h2 class="font-display text-[1.75rem] font-extrabold leading-tight sm:text-[2rem]">Empresas, colegios y grupos</h2>
      <p class="mt-3 max-w-md text-gris">Team building, giras de estudio y salidas privadas con la logística resuelta. Cotización en 24 horas.</p>
      <span class="mt-8 inline-block font-bold text-naranja-700 underline decoration-2 underline-offset-4">Cotizar para mi grupo</span>
    </a>
  </section>

  <!-- Preguntas -->
  <section class="wrap pb-20 sm:pb-28" aria-labelledby="faq">
    <h2 id="faq" class="text-h2">Preguntas frecuentes</h2>
    <div class="mt-8 max-w-3xl divide-y divide-roca border-y border-roca">
      {faq.slice(0, 4).map((f) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-display text-lg font-bold">
            {f.q}
            <span class="text-2xl text-naranja-700 transition group-open:rotate-45" aria-hidden="true">+</span>
          </summary>
          <p class="mt-3 text-gris">{f.a}</p>
        </details>
      ))}
    </div>
    <a href="/preguntas-frecuentes" class="mt-6 inline-block font-bold text-naranja-700 underline decoration-2 underline-offset-4">Ver todas las preguntas</a>
  </section>

  <CtaBand />
</Base>
