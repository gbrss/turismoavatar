---
// Home armado con bloques: el contenido vive en src/content/pages/home.json y se edita desde /admin (editor visual).
// Se genera como HTML estático: React solo corre en el build, el navegador no descarga JavaScript de React.
import Base from '@/layouts/Base.astro';
import PageRender, { type PageData } from '@/blocks/registry';
import { getSiteData, collectKeys } from '@/lib/sitedata';
import { faq } from '@/data/faq';
import home from '@/content/pages/home.json';

const page = home as unknown as PageData;
const siteData = await getSiteData({ extraKeys: collectKeys(page) });
const visibles = page.content.filter((b) => !b.props.hidden);
// Menú transparente solo si la página parte con la portada
const hero = visibles[0]?.type === 'Hero';
const faqBlock = page.content.find((b) => b.type === 'Faq' && !b.props.hidden);

const faqLd = faqBlock && {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.slice(0, Number(faqBlock.props.cantidad) || 4).map((f) => ({ '@type': 'Question', name: f.q, acceptedAnswer: { '@type': 'Answer', text: f.a } })),
};
const { title, description } = page.root?.props ?? {};
---

<Base transparentHeader={hero} jsonLd={faqLd || undefined} title={title || undefined} description={description || undefined}>
  <PageRender page={page} site={siteData} />
</Base>

<script>
  import '@/scripts/gallery';
  import '@/scripts/map';
  import '@/scripts/escapadas';
  // Video de portada: aparece con un fundido apenas empieza a reproducirse
  const v = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (v) {
    const show = () => (v.style.opacity = '1');
    if (!v.paused && v.readyState > 2) show();
    else v.addEventListener('playing', show, { once: true });
  }
</script>
