---
interface Props { dark?: boolean }
const { dark = false } = Astro.props;
const id = `nl-${Math.random().toString(36).slice(2, 7)}`;
---

<form data-newsletter class="grid gap-2" action="/api/newsletter" method="post">
  <label for={id} class:list={['font-display text-xl font-semibold', dark ? 'text-white' : 'text-tinta']}>Panoramas y descuentos en tu correo</label>
  <div class="flex gap-2">
    <input
      id={id}
      name="email"
      type="email"
      required
      autocomplete="email"
      placeholder="tu@correo.cl"
      class:list={[
        'min-h-12 min-w-0 flex-1 rounded-full px-4',
        dark ? 'bg-white/10 text-white placeholder:text-white/50' : 'border border-roca bg-white',
      ]}
    />
    <input type="text" name="website" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
    <button class="btn btn-primary !min-h-12 !px-5">Suscribirme</button>
  </div>
  <p data-status role="status" class:list={['text-sm', dark ? 'text-white/70' : 'text-gris']}></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-newsletter]').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.querySelector<HTMLElement>('[data-status]')!;
      const btn = form.querySelector('button')!;
      btn.disabled = true;
      status.textContent = 'Enviando…';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok) throw new Error(data.error || 'No pudimos registrar tu correo.');
        status.textContent = '¡Listo! Te avisaremos de nuevos panoramas.';
        form.reset();
      } catch (err) {
        status.textContent = err instanceof Error ? err.message : 'No pudimos registrar tu correo. Intenta de nuevo.';
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
