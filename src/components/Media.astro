---
import { Picture } from 'astro:assets';
import { getMedia, cmsImage } from '@/lib/media';

interface Props {
  src?: string;
  alt: string;
  widths?: number[];
  sizes?: string;
  class?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
}
const {
  src,
  alt,
  widths = [400, 800, 1200],
  sizes = '(min-width: 1024px) 33vw, 100vw',
  class: className = '',
  loading = 'lazy',
  fetchpriority = 'auto',
} = Astro.props;
const img = getMedia(src);
const cms = img ? undefined : cmsImage(src);
// Variación de color estable por imagen para los marcadores de posición
const hue = [...(src ?? alt)].reduce((a, c) => a + c.charCodeAt(0), 0) % 3;
const tones = [
  ['#192a3d', '#0a72a8'],
  ['#0f1b29', '#3a4f66'],
  ['#192a3d', '#b35000'],
][hue];
---

{
  cms ? (
    <picture>
      <source type="image/webp" srcset={cms.widths.map((w) => `${cms.url(w)} ${w}w`).join(', ')} sizes={sizes} />
      <img src={cms.src} alt={alt} width={cms.width} height={cms.height} sizes={sizes} loading={loading} fetchpriority={fetchpriority} decoding="async" class:list={['h-full w-full object-cover', className]} />
    </picture>
  ) : img ? (
    <Picture
      src={img}
      alt={alt}
      widths={widths.filter((w) => w <= img.width).length ? widths.filter((w) => w <= img.width) : [img.width]}
      sizes={sizes}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      loading={loading}
      fetchpriority={fetchpriority}
      class:list={['h-full w-full object-cover', className]}
    />
  ) : (
    <div
      role="img"
      aria-label={alt}
      class:list={['relative h-full w-full overflow-hidden', className]}
      style={`background: radial-gradient(120% 90% at 20% 10%, ${tones[1]} 0%, ${tones[0]} 60%);`}
    >
      <svg class="absolute inset-x-0 bottom-0 w-full opacity-30" viewBox="0 0 400 120" preserveAspectRatio="none" aria-hidden="true">
        <path d="M0 80 C60 40 110 100 170 70 S290 30 400 60 L400 120 L0 120Z" fill="#f2f5f7" />
        <path d="M0 100 C80 80 140 115 220 95 S330 80 400 92 L400 120 L0 120Z" fill="#f2f5f7" opacity=".6" />
      </svg>
    </div>
  )
}
