---
import { Image } from 'astro:assets';
import horizontal from '@/assets/brand/logo-horizontal.png';
import vertical from '@/assets/brand/logo-vertical.png';
interface Props { variant?: 'horizontal' | 'vertical'; class?: string; eager?: boolean }
const { variant = 'horizontal', class: className = '', eager = true } = Astro.props;
const src = variant === 'horizontal' ? horizontal : vertical;
---

<Image
  src={src}
  alt="Turismo Avatar"
  widths={variant === 'horizontal' ? [180, 360] : [160, 320]}
  sizes={variant === 'horizontal' ? '180px' : '160px'}
  class:list={[variant === 'horizontal' ? 'h-11 w-auto' : 'h-auto w-40', className]}
  loading={eager ? 'eager' : 'lazy'}
/>
