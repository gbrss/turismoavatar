---
import { Image } from 'astro:assets';
import { getMedia } from '@/lib/media';
interface Props { light?: boolean; class?: string }
const { light = false, class: className = '' } = Astro.props;
const logo = getMedia('2024/10/LOGO.png');
---

<span class:list={['inline-flex items-center gap-2.5', className]}>
  {
    logo ? (
      <Image src={logo} alt="" width={44} height={Math.round((44 * logo.height) / logo.width)} class="h-11 w-auto" loading="eager" />
    ) : (
      <svg viewBox="0 0 40 40" class="h-10 w-10 shrink-0" aria-hidden="true">
        <circle cx="20" cy="20" r="19" fill={light ? '#eef2ef' : '#0e3b43'} />
        <path d="M7 27 L16 14 L21 21 L25 16 L33 27 Z" fill={light ? '#0e3b43' : '#eef2ef'} />
        <path d="M6 30 C12 27 16 32 22 29 S30 27 34 29" stroke="#c2264b" stroke-width="2.4" fill="none" stroke-linecap="round" />
      </svg>
    )
  }
  <span class="leading-none">
    <span class="block font-display text-[1.55rem] font-extrabold tracking-tight">Turismo Avatar</span>
    <span class:list={['block text-[0.78rem] font-medium', light ? 'text-white/75' : 'text-gris']}>Experiencias en el Biobío</span>
  </span>
</span>
