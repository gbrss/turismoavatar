---
import type { CollectionEntry } from 'astro:content';
import Media from './Media.astro';
import { categorias } from '@/content.config';
import { destinoBySlug } from '@/data/destinos';
import { clp } from '@/data/site';
interface Props { exp: CollectionEntry<'experiencias'>; size?: 'lg' | 'md' }
const { exp, size = 'md' } = Astro.props;
const d = exp.data;
const lugares = d.destinos.map((s) => destinoBySlug(s)?.name ?? s).join(' y ');
---

<article class="group relative" data-category={d.category} data-destinos={d.destinos.join(' ')}>
  <div class:list={['overflow-hidden rounded-xl bg-rio', size === 'lg' ? 'aspect-[4/3]' : 'aspect-[4/3] sm:aspect-[4/5]']}>
    <Media src={d.image} alt={d.title} sizes={size === 'lg' ? '(min-width: 1024px) 50vw, 100vw' : '(min-width: 1024px) 25vw, (min-width: 640px) 50vw, 100vw'} class="transition-transform duration-500 group-hover:scale-[1.03]" />
  </div>
  <p class="mt-3 text-sm font-semibold text-laguna">{categorias[d.category]}</p>
  <h3 class:list={['mt-1 font-display font-extrabold leading-[1.05]', size === 'lg' ? 'text-h2' : 'text-[1.7rem]']}>
    <a href={`/experiencias/${exp.id}`} class="after:absolute after:inset-0 hover:text-rio">{d.title}</a>
  </h3>
  <p class="mt-2 text-gris">{d.duration} en {lugares}</p>
  <p class="mt-1 font-semibold">{d.priceFrom ? `Desde ${clp(d.priceFrom)} por ${d.priceUnit}` : 'Precio a consultar'}</p>
</article>
