---
// Video de fondo del hero: public/media/video/hero.mp4 (Google Flow, sin audio, loop con fundido).
// Se oculta con "reducir movimiento": en ese caso queda la foto.
---

<video
  class="pointer-events-none absolute inset-0 h-full w-full object-cover object-[62%_45%] opacity-0 transition-opacity duration-500 motion-reduce:hidden"
  onplaying="this.style.opacity=1"
  autoplay
  muted
  loop
  playsinline
  preload="auto"
  aria-hidden="true"
  tabindex="-1"
>
  <source src="/media/video/hero.mp4" type="video/mp4" />
</video>
