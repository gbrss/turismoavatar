---
// Video de fondo del hero: YouTube silenciado, sin controles ni pausa, con loop por fundido a oscuro.
// El reproductor se dibuja a 1920×1080 y se escala con CSS para cubrir: así YouTube entrega HD también en móviles.
// No se carga con "reducir movimiento" ni con ahorro de datos: en esos casos queda la foto.
import { site } from '@/data/site';
const { id, start, end } = site.heroVideo;
---

<link rel="preconnect" href="https://www.youtube-nocookie.com" />
<link rel="preconnect" href="https://www.youtube.com" />
<link rel="preconnect" href="https://i.ytimg.com" />
<link rel="preconnect" href="https://www.google.com" />

<div data-hero-video data-id={id} data-start={start} data-end={end} class="pointer-events-none absolute inset-0 overflow-hidden bg-marino-900 opacity-0 transition-opacity duration-700" aria-hidden="true">
  <div data-yt-slot class="absolute left-1/2 top-1/2 h-[1080px] w-[1920px] origin-center transition-opacity duration-700" style="transform: translate(-50%, -50%) scale(1)"></div>
</div>

<script>
  type YTPlayer = { mute(): void; playVideo(): void; seekTo(s: number, allow: boolean): void; getCurrentTime(): number };
  declare global { interface Window { YT?: any; onYouTubeIframeAPIReady?: () => void } }

  const box = document.querySelector<HTMLElement>('[data-hero-video]');
  const conn = (navigator as Navigator & { connection?: { saveData?: boolean; effectiveType?: string } }).connection;
  const skip = !box || matchMedia('(prefers-reduced-motion: reduce)').matches || conn?.saveData || /(^|-)2g/.test(conn?.effectiveType ?? '');

  if (!skip && box) {
    const id = box.dataset.id!;
    const start = Number(box.dataset.start);
    const end = Number(box.dataset.end);
    const FADE = 700;
    const CROP = 1.22; // recorte extra para esconder bordes y la marca de YouTube
    const slot = box.querySelector<HTMLElement>('[data-yt-slot]')!;

    // Escala "cover" del reproductor de 1920×1080 sobre el tamaño real del hero
    const fit = () => {
      const s = Math.max(box.clientWidth / 1920, box.clientHeight / 1080) * CROP;
      slot.style.transform = `translate(-50%, -50%) scale(${s})`;
    };
    fit();
    new ResizeObserver(fit).observe(box);

    window.onYouTubeIframeAPIReady = () => {
      let shown = false;
      let looping = false;
      const player: YTPlayer = new window.YT.Player(slot.appendChild(document.createElement('div')), {
        host: 'https://www.youtube-nocookie.com',
        videoId: id,
        width: 1920,
        height: 1080,
        playerVars: { autoplay: 1, mute: 1, controls: 0, disablekb: 1, fs: 0, rel: 0, playsinline: 1, iv_load_policy: 3, modestbranding: 1, start, end, vq: 'hd1080' },
        events: {
          onReady: (e: { target: YTPlayer }) => {
            e.target.mute();
            e.target.playVideo();
          },
          onStateChange: (e: { data: number }) => {
            if (e.data === 1 && !shown) {
              shown = true;
              setTimeout(() => (box.style.opacity = '1'), 600);
            }
            if (e.data === 0) {
              player.seekTo(start, true);
              player.playVideo();
            }
          },
        },
      });
      // Loop poco notorio: fundido a oscuro, salto al inicio del tramo y vuelta a aparecer
      setInterval(() => {
        if (!shown || looping) return;
        if ((player.getCurrentTime?.() ?? 0) >= end - 1.1) {
          looping = true;
          slot.style.opacity = '0';
          setTimeout(() => {
            player.seekTo(start, true);
            setTimeout(() => {
              slot.style.opacity = '1';
              setTimeout(() => (looping = false), FADE);
            }, 300);
          }, FADE);
        }
      }, 200);
    };

    // Cargar la API de inmediato (el script del módulo ya corre tras el HTML)
    const tag = document.createElement('script');
    tag.src = 'https://www.youtube.com/iframe_api';
    tag.async = true;
    document.head.append(tag);
  }
</script>
