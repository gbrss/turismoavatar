{
  "name": "turismoavatar",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "description": "Turismo Avatar — sitio Astro para Cloudflare Pages (tours, alojamientos y reservas en el Biobío)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler pages dev ./dist",
    "check": "astro check",
    "wp:export": "node scripts/export-wp.mjs",
    "db:init": "wrangler d1 execute turismoavatar --remote --file=db/schema.sql",
    "db:init:local": "wrangler d1 execute turismoavatar --local --file=db/schema.sql",
    "deploy": "astro build && wrangler pages deploy ./dist --project-name=turismoavatar"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.5",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "~7.3.8",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261114.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.162.0"
  }
}
